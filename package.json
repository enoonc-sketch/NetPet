{
  "name": "netpet",
  "version": "1.3.0",
  "description": "NetPet - 桌面智能宠物：网速与电脑状态监控",
  "author": "NetPet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "portable": "electron-builder --win portable",
    "pack": "electron-builder --win dir",
    "bundle": "esbuild src/pets3d.js --bundle --minify --format=iife --global-name=NetPet3D --outfile=pets.bundle.js",
    "test": "node --no-warnings tests/unit.js",
    "build:native": "cd native/procnet && npx node-gyp rebuild --target=37.2.0 --dist-url=https://electronjs.org/headers",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.netpet.app",
    "productName": "NetPet",
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "petstate.js",
      "security.js",
      "fullscreen.js",
      "petlist.js",
      "index.html",
      "panel.html",
      "dashboard.html",
      "pets.bundle.js",
      "assets/**",
      "procnet.js",
      "native/procnet/build/Release/procnet.node"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NetPet",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "2052",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "NetPet-portable.exe"
    }
  }
}
