{
  "name": "netpet",
  "version": "1.5.0",
  "description": "NetPet - 桌面智能宠物：网速与电脑状态监控",
  "author": "NetPet",
  "license": "MIT",
  "homepage": "https://github.com/enoonc-sketch/NetPet",
  "repository": {
    "type": "git",
    "url": "https://github.com/enoonc-sketch/NetPet.git"
  },
  "main": "out/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --no-warnings out/unit.cjs",
    "check": "npm run typecheck && npm test",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "portable": "npm run build && electron-builder --win portable --publish never",
    "dist:all": "npm run build && electron-builder --win nsis portable --publish never",
    "pack": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "three": "0.170.0",
    "@types/three": "0.170.0"
  },
  "build": {
    "appId": "com.netpet.app",
    "productName": "NetPet",
    "forceCodeSigning": false,
    "files": [
      "out/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NetPet",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "2052",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "copyright": "Copyright © 2026 NetPet",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
